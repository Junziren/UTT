#pragma once
#include <JuceHeader.h>

class UTTProcessor;

class UTTEditor : public juce::AudioProcessorEditor,
                  public juce::Timer
{
public:
    explicit UTTEditor(UTTProcessor& p);
    ~UTTEditor() override;
