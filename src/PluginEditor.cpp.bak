#include "PluginEditor.h"
#include "PluginProcessor.h"

UTTEditor::UTTEditor(UTTProcessor& p)
    : AudioProcessorEditor(&p), processor(p)
{
    setSize(920, 680);
    setResizable(true, true);
    setResizeLimits(700, 500, 1600, 1000);

    // Minimal: just a title label
    titleLabel = std::make_unique<juce::Label>("title", "UTT  Utility Toolbox");
    titleLabel->setFont(juce::Font(18.0f, juce::Font::bold));
    titleLabel->setColour(juce::Label::textColourId, juce::Colour(0xffff6600));
    titleLabel->setJustificationType(juce::Justification::centred);
    addAndMakeVisible(*titleLabel);
}

UTTEditor::~UTTEditor() = default;

void UTTEditor::paint(juce::Graphics& g)
{
    g.fillAll(juce::Colour(0xff1a1a1a));
}

void UTTEditor::resized()
{
    titleLabel->setBounds(getLocalBounds().removeFromTop(32));
}

void UTTEditor::timerCallback() {}
