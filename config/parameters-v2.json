{
  "$schema": "./parameters-v2.schema.json",
  "version": 2,
  "description": "UTT parameter contract v2. Authoritative source of truth for host-facing parameters. IDs and order are release ABI: never rename, renumber or reorder. Meters and UI-local options are intentionally not host parameters. Config wins over docs and implementation on conflict (openFAD M0 rule).",
  "parameters": [
    { "id": "dcOffsetBypass",   "type": "bool",   "name": "DC Offset",          "default": true,  "note": "true = DC filter bypassed" },
    { "id": "phaseInvertL",     "type": "bool",   "name": "Phase Invert L",     "default": false },
    { "id": "phaseInvertR",     "type": "bool",   "name": "Phase Invert R",     "default": false },
    { "id": "phaseOffset",      "type": "float",  "name": "Phase Offset",       "min": 0.0,    "max": 360.0, "default": 0.0,   "unit": "deg", "note": "exact at 1 kHz via two cascaded 1st-order allpasses; 0 = hard bypass" },
    { "id": "gain",             "type": "float",  "name": "Gain",               "min": -96.0,  "max": 24.0,  "default": 0.0,   "unit": "dB" },
    { "id": "msMode",           "type": "choice", "name": "MS Mode",            "choices": ["Bypass", "Encode", "Decode"], "default": 0 },
    { "id": "monoMode",         "type": "choice", "name": "Mono Mode",          "choices": ["Off", "L+R Sum", "Mid Only", "Side Only"], "default": 0 },
    { "id": "stereoSeparation", "type": "float",  "name": "Stereo Separation",  "min": 0.0,    "max": 100.0, "default": 100.0, "unit": "%", "note": "side gain; no-op after mono modes (side is already zero)" },
    { "id": "monoToStereo",     "type": "choice", "name": "Mono to Stereo",     "choices": ["Off", "L->Both", "R->Both"], "default": 0 },
    { "id": "channelSwap",      "type": "bool",   "name": "Channel Swap",       "default": false },
    { "id": "pan",              "type": "float",  "name": "Pan",                "min": -100.0, "max": 100.0, "default": 0.0,   "unit": "%" },
    { "id": "outputLGain",      "type": "float",  "name": "Output L Gain",      "min": -96.0,  "max": 12.0,  "default": 0.0,   "unit": "dB" },
    { "id": "outputRGain",      "type": "float",  "name": "Output R Gain",      "min": -96.0,  "max": 12.0,  "default": 0.0,   "unit": "dB" },
    { "id": "outputLMute",      "type": "bool",   "name": "Output L Mute",      "default": false },
    { "id": "outputRMute",      "type": "bool",   "name": "Output R Mute",      "default": false },
    { "id": "outputLSolo",      "type": "bool",   "name": "Output L Solo",      "default": false },
    { "id": "outputRSolo",      "type": "bool",   "name": "Output R Solo",      "default": false },
    { "id": "recordEnable",     "type": "bool",   "name": "Record Enable",      "default": false }
  ],
  "removedInV2": {
    "note": "v0.2 pseudo-parameters ignored when restoring legacy states: meterLPeak, meterRPeak, meterLRMS, meterRRMS, phaseCorrelation, lufsMomentary, lufsShortTerm, lufsIntegrated, themeIndex",
    "migration": "meters publish via atomics; UI theme persists as the uiTheme state-tree property"
  }
}
